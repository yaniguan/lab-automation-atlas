{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/yaniguan/lab-automation-atlas/schema/atlas.schema.json",
  "title": "LabAutomationAtlasCatalog",
  "description": "Strict machine-readable catalog schema for lab-automation-atlas (Auto-Lab Layer L5).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "atlas_name",
    "last_verified",
    "categories",
    "entries"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "atlas_name": {
      "type": "string",
      "const": "lab-automation-atlas"
    },
    "last_verified": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "categories": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "description"],
        "properties": {
          "id": {
            "type": "string",
            "enum": [
              "autolab_sibling",
              "hardware",
              "cloud_lab",
              "software",
              "chemistry_and_procurement",
              "dataset",
              "simulation_and_verification"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 3
          },
          "description": {
            "type": "string",
            "minLength": 10
          }
        }
      }
    },
    "entries": {
      "type": "array",
      "minItems": 30,
      "items": {
        "$ref": "#/$defs/AtlasEntry"
      }
    }
  },
  "$defs": {
    "LinkItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "url"],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "pattern": "^https://[^\\s]+$"
        }
      }
    },
    "AnalyticalModality": {
      "type": "string",
      "enum": [
        "XRD",
        "Raman",
        "NMR",
        "LC-MS",
        "GC-MS",
        "UV-Vis",
        "FTIR",
        "fluorescence_plate_reader",
        "optical_imaging",
        "acoustic_monitoring",
        "SAXS_WAXS",
        "chemiresistive_gas_sensor"
      ]
    },
    "DeckArchitecture": {
      "type": "string",
      "enum": [
        "sbs_fixed_slots",
        "sbs_coordinate_grid",
        "carrier_rails",
        "modular_workcell",
        "flow_batch_reactor",
        "cloud_symbolic_facility",
        "beamline_station"
      ]
    },
    "HardwareProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "platform_id",
        "instrument_model",
        "deck_architecture",
        "api_level",
        "max_deck_slots",
        "staging_slots",
        "min_volume_ul",
        "max_volume_ul",
        "dead_volume_floor_ul",
        "min_temp_c",
        "max_temp_c",
        "high_temp_seal_threshold_c"
      ],
      "properties": {
        "platform_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_]*$"
        },
        "instrument_model": {
          "type": "string",
          "minLength": 1
        },
        "deck_architecture": {
          "$ref": "#/$defs/DeckArchitecture"
        },
        "api_level": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "max_deck_slots": {
          "type": ["integer", "null"],
          "minimum": 1
        },
        "staging_slots": {
          "type": "integer",
          "minimum": 0
        },
        "min_volume_ul": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "max_volume_ul": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "dead_volume_floor_ul": {
          "type": "number",
          "minimum": 0
        },
        "min_temp_c": {
          "type": "number",
          "minimum": -200
        },
        "max_temp_c": {
          "type": "number",
          "maximum": 500
        },
        "high_temp_seal_threshold_c": {
          "type": "number",
          "minimum": -200
        }
      }
    },
    "HardwareCapabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "api_level",
        "max_deck_slots",
        "min_volume_ul"
      ],
      "properties": {
        "platform_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_]*$"
        },
        "deck_architecture": {
          "$ref": "#/$defs/DeckArchitecture"
        },
        "api_level": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "max_deck_slots": {
          "type": ["integer", "null"],
          "minimum": 1
        },
        "staging_slots": {
          "type": "integer",
          "minimum": 0
        },
        "min_volume_ul": {
          "type": ["number", "null"],
          "exclusiveMinimum": 0
        },
        "max_volume_ul": {
          "type": ["number", "null"],
          "exclusiveMinimum": 0
        },
        "dead_volume_floor_ul": {
          "type": ["number", "null"],
          "minimum": 0
        },
        "min_temp_c": {
          "type": ["number", "null"],
          "minimum": -200
        },
        "max_temp_c": {
          "type": ["number", "null"],
          "maximum": 500
        },
        "high_temp_seal_threshold_c": {
          "type": ["number", "null"],
          "minimum": -200
        },
        "profiles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/HardwareProfile"
          }
        }
      }
    },
    "AtlasEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "category",
        "role",
        "layer",
        "maintenance_status",
        "spdx_license",
        "osi_approved",
        "license_evidence",
        "commercial_use_ok",
        "links",
        "supported_hardware",
        "protocol_formats",
        "has_simulator",
        "allowed_purposes",
        "scraping_policy",
        "contamination_warning",
        "huggingface_id",
        "doi",
        "tasks",
        "record_count",
        "last_checked"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "type": "string",
          "enum": [
            "autolab_sibling",
            "hardware",
            "cloud_lab",
            "software",
            "chemistry_and_procurement",
            "dataset",
            "simulation_and_verification"
          ]
        },
        "role": {
          "type": "string",
          "minLength": 5
        },
        "layer": {
          "type": ["string", "null"],
          "enum": ["Hub", "L0", "L1", "L2", "L3", "L4", "L5", "L6", null]
        },
        "maintenance_status": {
          "type": "string",
          "enum": [
            "active",
            "maintenance",
            "legacy",
            "archived",
            "commercial_restructured"
          ]
        },
        "spdx_license": {
          "type": "string",
          "minLength": 2
        },
        "osi_approved": {
          "type": "boolean"
        },
        "license_evidence": {
          "type": "string",
          "pattern": "^https://[^\\s]+$"
        },
        "commercial_use_ok": {
          "type": "boolean"
        },
        "links": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/LinkItem"
          }
        },
        "supported_hardware": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "protocol_formats": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "has_simulator": {
          "type": ["boolean", "null"]
        },
        "hardware_capabilities": {
          "anyOf": [
            { "$ref": "#/$defs/HardwareCapabilities" },
            { "type": "null" }
          ]
        },
        "analytical_modalities": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/AnalyticalModality"
          }
        },
        "allowed_purposes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": [
              "train_commercial",
              "train_academic",
              "eval_only",
              "rag_pointer_only",
              "tool_integration"
            ]
          }
        },
        "scraping_policy": {
          "type": "string",
          "enum": [
            "git_or_hf_download",
            "public_api_rate_limited",
            "no_bulk_scraping_per_article",
            "vendor_docs_pointer_only"
          ]
        },
        "contamination_warning": {
          "type": ["string", "null"]
        },
        "huggingface_id": {
          "type": ["string", "null"]
        },
        "doi": {
          "type": ["string", "null"]
        },
        "tasks": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "record_count": {
          "type": ["string", "null"]
        },
        "last_checked": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        }
      }
    }
  }
}
